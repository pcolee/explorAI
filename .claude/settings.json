{
  "permissions": {
    "allow": [
      "Bash(scripts/sync.sh *)",
      "Bash(./scripts/sync.sh *)",
      "Bash(scripts/check.sh)",
      "Bash(./scripts/check.sh)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync.sh pull --hook", "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync.sh pull --quiet --hook", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-git.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
